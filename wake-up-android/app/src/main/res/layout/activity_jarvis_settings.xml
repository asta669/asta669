<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Votre assistant."
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Un briefing parlé, juste après l'alarme"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/enableJarvis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/good"
            android:text="Activer Jarvis après l'alarme"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/useCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:buttonTint="@color/good"
            android:text="Lire mes rendez-vous du jour (Google Agenda)"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Comment m'appeler"
            android:textColor="@color/muted" />

        <EditText
            android:minHeight="48dp"
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="sir"
            android:inputType="textPersonName"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ma routine (séparée par des virgules)"
            android:textColor="@color/muted" />

        <EditText
            android:minHeight="48dp"
            android:id="@+id/routineInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="footing, lecture, écrire sur Substack"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Clé Gemini facultative"
            android:textColor="@color/muted" />

        <EditText
            android:minHeight="48dp"
            android:id="@+id/keyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="AIza…"
            android:inputType="textPassword"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sans clé : briefing local. Avec une clé : le nom, la routine et les rendez-vous choisis sont transmis à Gemini."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Modèle Gemini (avancé)"
            android:textColor="@color/muted" />

        <EditText
            android:minHeight="48dp"
            android:id="@+id/modelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="gemini-2.0-flash"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/muted" />

        <Button
            android:id="@+id/testJarvisBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tester le briefing" />

        <Button
            android:id="@+id/saveJarvisBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enregistrer" />

    </LinearLayout>
</ScrollView>
