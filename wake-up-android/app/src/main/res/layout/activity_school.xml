<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/schoolBack"
            style="@style/Widget.WakeUp.Button.Quiet" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/school_back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/school_title"
            android:textAppearance="@style/TextAppearance.WakeUp.Title" android:textSize="36sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
            android:text="@string/school_subtitle" android:textAppearance="@style/TextAppearance.WakeUp.Body" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.WakeUp.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp">
                <TextView android:id="@+id/schoolState" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.WakeUp.Title" />
                <TextView android:id="@+id/schoolDetails" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.WakeUp.Body" android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/schoolOn"
                    style="@style/Widget.WakeUp.Button" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/school_on" />
                <com.google.android.material.button.MaterialButton android:id="@+id/schoolOff"
                    style="@style/Widget.WakeUp.Button.Secondary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/school_off" />
                <TextView android:id="@+id/schoolFeedback" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.WakeUp.Body" android:textColor="@color/danger"
                    android:accessibilityLiveRegion="polite" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.WakeUp.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/school_permissions_title" android:textAppearance="@style/TextAppearance.WakeUp.Title" />
                <TextView android:id="@+id/schoolPermissionStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.WakeUp.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/schoolPermission"
                    style="@style/Widget.WakeUp.Button.Quiet" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/school_permissions_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.WakeUp.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp">
                <TextView android:id="@+id/schoolAirplaneState" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.WakeUp.Title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/school_airplane_help"
                    android:textAppearance="@style/TextAppearance.WakeUp.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/schoolAirplane"
                    style="@style/Widget.WakeUp.Button.Quiet" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/school_airplane_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:layout_marginBottom="24dp" android:text="@string/school_priority_help"
            android:textAppearance="@style/TextAppearance.WakeUp.Body" />
    </LinearLayout>
</ScrollView>
